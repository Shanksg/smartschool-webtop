# Copy to .env and fill in. .env is gitignored - never commit real values.

# Apprise notifier URLs, comma-separated.
#   Home Assistant webhook: jsons://your-instance.ui.nabu.casa/api/webhook/<id>
#   Telegram:               tgram://<bottoken>/<ChatID>
NOTIFIERS=

# MQTT broker for Home Assistant entity discovery (optional).
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Homework check times (24h, comma-separated).
SCHEDULES=12:00,16:00,20:00

# How often to poll CheckBackgroundToken to keep the session alive.
# The SmartSchool SPA itself uses 30 minutes; stay under it.
TOKEN_ROTATE_MINUTES=20

# Set to 0 only if you have a TLS interception proxy.
VERIFY_TLS=1

# On first sighting of a student, record existing homework without notifying
# (avoids a burst of "new" items that are simply pre-existing). 0 to notify.
SEED_QUIETLY=1

# Comma-separated values a teacher may type to mean "no homework".
# Defaults cover אין / לא הוזן / ללא / none / n/a / -
NO_HOMEWORK_VALUES=

# Monitor the school message inbox alongside homework (1 = on).
MESSAGES_ENABLED=1

# Assumed webToken lifetime. Measured at 9 hours (the cookie's own Expires),
# and the server never sends Set-Cookie, so this is how expiry is predicted.
# Treat it as an upper bound: a token pasted late in its life dies sooner.
TOKEN_TTL_HOURS=9

# Warn this many minutes before the predicted expiry, so you can swap the
# token without missing a check.
TOKEN_WARN_MINUTES=45
